{
  "$schema": "https://quentinzhang.github.io/launch-profile-manifest/spec/browser-task/v0.1/site-target-profile.schema.json",
  "profileVersion": "0.1",
  "id": "example-directory",
  "name": "Example Directory",
  "hosts": ["directory.example"],
  "submissionUrl": "https://directory.example/submit",
  "homepageUrl": "https://directory.example",
  "channelType": "submission_listing",
  "bestFit": "Publicly available software products",
  "submissionPricing": "free",
  "requiresLogin": false,
  "submissionNote": "Example-only target. Replace it with a currently verified live target before delivery.",
  "manualFields": ["logoUpload"],
  "manualSteps": ["Review the completed form and press the final submit button."],
  "fieldMappingStatus": "verify_before_fill",
  "fieldSelectors": {
    "productName": ["#product-name", "[name='product_name']"],
    "websiteUrl": ["#website", "[name='website']"],
    "shortDescription": ["#description", "[name='description']"]
  },
  "fieldHints": {
    "productName": ["product name"],
    "websiteUrl": ["website", "product URL"],
    "shortDescription": ["short description"]
  },
  "source": "example-only",
  "extensions": {}
}
