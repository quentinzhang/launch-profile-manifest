{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quentinzhang.github.io/launch-profile-manifest/spec/v0.1/release-envelope.schema.json",
  "title": "Release Envelope v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "envelopeVersion", "id", "profileId", "type", "status", "provenance"],
  "properties": {
    "$schema": {"const": "https://quentinzhang.github.io/launch-profile-manifest/spec/v0.1/release-envelope.schema.json"},
    "envelopeVersion": {"const": "0.1"},
    "id": {"type": "string", "format": "uri"},
    "profileId": {"type": "string", "format": "uri"},
    "type": {"enum": ["first_launch", "relaunch", "major_release", "integration", "market_entry", "distribution_wave"]},
    "version": {"type": "string", "maxLength": 80},
    "status": {"enum": ["draft", "planned", "private_beta", "public_beta", "live", "paused", "archived"]},
    "date": {"type": "string", "format": "date"},
    "name": {"$ref": "https://quentinzhang.github.io/launch-profile-manifest/spec/v0.1/launch-profile-manifest.schema.json#/$defs/localizedText"},
    "summary": {"$ref": "https://quentinzhang.github.io/launch-profile-manifest/spec/v0.1/launch-profile-manifest.schema.json#/$defs/localizedText"},
    "changes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": {"$ref": "https://quentinzhang.github.io/launch-profile-manifest/spec/v0.1/launch-profile-manifest.schema.json#/$defs/localizedText"},
          "description": {"$ref": "https://quentinzhang.github.io/launch-profile-manifest/spec/v0.1/launch-profile-manifest.schema.json#/$defs/localizedText"}
        }
      }
    },
    "launchUrl": {"type": "string", "format": "uri"},
    "assets": {"type": "array", "maxItems": 100, "items": {"$ref": "https://quentinzhang.github.io/launch-profile-manifest/spec/v0.1/launch-profile-manifest.schema.json#/$defs/asset"}},
    "channels": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1}},
    "provenance": {"$ref": "https://quentinzhang.github.io/launch-profile-manifest/spec/v0.1/launch-profile-manifest.schema.json#/$defs/provenance"},
    "extensions": {"type": "object", "default": {}}
  }
}
